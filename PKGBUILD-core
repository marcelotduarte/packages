# makepkg-mingw -sCLfi --noconfirm -p PKGBUILD-core

_realname=freeze-core
_pyname=${_realname/-/_}
pkgbase=mingw-w64-python-${_realname}
pkgname=("${MINGW_PACKAGE_PREFIX}-python-${_realname}")
pkgver=0.7.2
pkgrel=1
pkgdesc="Core dependency for cx_Freeze (mingw-w64)"
arch=('any')
mingw_arch=('mingw32' 'mingw64' 'ucrt64' 'clang64' 'clangarm64')
url="https://github.com/marcelotduarte/freeze-core/"
msys2_repository_url='https://github.com/marcelotduarte/freeze-core'
msys2_references=(
  'purl: pkg:pypi/freeze-core'
)
license=('spdx:MIT')
depends=(
  "${MINGW_PACKAGE_PREFIX}-ca-certificates"
  "${MINGW_PACKAGE_PREFIX}-python"
  "${MINGW_PACKAGE_PREFIX}-python-filelock"
)
if [ "${MINGW_ARCH}" != "mingw32" ]; then
  depends+=(
    "${MINGW_PACKAGE_PREFIX}-python-cabarchive"
    "${MINGW_PACKAGE_PREFIX}-python-striprtf"
    "${MINGW_PACKAGE_PREFIX}-python-cx-logging"
  )
fi
makedepends=(
  "${MINGW_PACKAGE_PREFIX}-cc"
  "${MINGW_PACKAGE_PREFIX}-tools"
  "${MINGW_PACKAGE_PREFIX}-python-build"
  "${MINGW_PACKAGE_PREFIX}-python-installer"
  "${MINGW_PACKAGE_PREFIX}-python-setuptools"
)
checkdepends=(
  "${MINGW_PACKAGE_PREFIX}-python-pip"
  "${MINGW_PACKAGE_PREFIX}-python-coverage"
  "${MINGW_PACKAGE_PREFIX}-python-pytest"
)
options=(!strip)
if [ "$CI" == "true" ]; then
  pkgver=$(find ${_pyname}-*.tar.gz | awk -F- '{print $2}' | awk -F.tar.gz '{print $1}')
  source=("file://${startdir}/${_pyname}-${pkgver}.tar.gz")
  sha256sums=(SKIP)
else
  source=()
  sha256sums=()
fi

prepare() {
  if ! [ "$CI" == "true" ]; then
    # Local
    cd "../../${_realname}"
    pkgver=$(grep -m1 "^version = " pyproject.toml | awk -F\" '{print $2}')
    python -m build -s -x -n -o "${startdir}"
    cd "${srcdir}"
    echo "Extract tar archive"
    bsdtar -x -v -f "${startdir}/${_pyname}-${pkgver}.tar.gz"
  fi

  cd "${srcdir}/${_pyname}-${pkgver}"
  if [ "${MINGW_ARCH}" == "mingw32" ]; then
    sed -i 's/"cabarchive>=.*"/#"cabarchive"/' pyproject.toml
    sed -i 's/"striprtf>=.*"/#"striprtf"/' pyproject.toml
  fi

  rm -Rf "${srcdir}/python-${_realname}-${MSYSTEM}"
  cp -a "${srcdir}/${_pyname}-${pkgver}" "${srcdir}/python-${_realname}-${MSYSTEM}"
}

pkgver() {
  cd "python-${_realname}-${MSYSTEM}"
  grep -m1 "^version = " pyproject.toml | awk -F\" '{print $2}'
}

build() {
  cd "python-${_realname}-${MSYSTEM}"
  python -m build --wheel --skip-dependency-check --no-isolation
}

check() {
  pacman -R "${MINGW_PACKAGE_PREFIX}-python-${_realname}" --noconfirm --nodeps || true
  cd "python-${_realname}-${MSYSTEM}"
  pip install ${_realname} -f dist --no-deps --no-index --break-system-packages

  mkdir -p "${srcdir}/${_realname}-test"
  cp pyproject.toml "${srcdir}/${_realname}-test"
  cp -a tests "${srcdir}/${_realname}-test"

  cd "${srcdir}/${_realname}-test"
  coverage run || true
  coverage report
  pip uninstall ${_realname} -y --break-system-packages
}

package() {
  cd "python-${_realname}-${MSYSTEM}"
  MSYS2_ARG_CONV_EXCL="--prefix=" \
    python -m installer --prefix="${MINGW_PREFIX}" --destdir="${pkgdir}" dist/*.whl
  install -Dm644 LICENSE "${pkgdir}${MINGW_PREFIX}/share/licenses/python-${_realname}/LICENSE"
}
